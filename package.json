{
  "name": "axenapi-ui",
  "type": "module",
  "productName": "AxenApi",
  "version": "5.0.0",
  "description": "AxenApi Electron application",
  "main": "./out/main/index.js",
  "homepage": "https://axenix.pro",
  "author": {
    "name": "Axenix",
    "email": "info-russia@axenix.pro"
  },
  "license": "MIT",
  "scripts": {
    "start": "yarn update && dotenv -- cross-env NODE_ENV=development electron-vite dev",
    "preview": "dotenv -- cross-env PREVIEW=true electron-vite preview",
    "build": "dotenv -- cross-env DEBUG=electron-vite electron-vite build",
    "build:web": "dotenv -- cross-env DEBUG=electron-vite LOCAL_SERVER=false DESKTOP=false electron-vite build",
    "build:analize": "dotenv -- cross-env ANALYZE=true LOCAL_SERVER=false DESKTOP=false electron-vite build",
    "build:web-readonly": "dotenv -- cross-env READ_ONLY=true LOCAL_SERVER=false DESKTOP=false electron-vite build",
    "build:win": "yarn build && dotenv -e .env.electron -- electron-builder --win",
    "build:mac": "yarn build && dotenv -e .env.electron -- electron-builder --mac",
    "build:linux": "yarn build && dotenv -e .env.electron -- electron-builder --linux",
    "build:all": "yarn build && dotenv -e .env.electron -- electron-builder --linux --win --mac",
    "test": "jest --coverage",
    "test:fast": "jest --silent --coverage=false",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "postinstall": "husky",
    "format": "prettier --write . && eslint --fix .",
    "lint": "eslint .",
    "lint:error": "eslint --quiet .",
    "lint:electron": "eslint ./electron",
    "lint:src": "eslint ./src",
    "check": "npx tsc --noEmit",
    "check-types": "yarn check-types:node ; yarn check-types:web",
    "check-types:node": "npx tsc --project tsconfig.node.json --noEmit",
    "check-types:web": "npx tsc --project tsconfig.web.json --noEmit",
    "check:deps": "dpdm --exit-code circular:1 --no-tree ./src/*/**.{ts,tsx}",
    "update": "yarn update-artifacts && yarn generate-api && yarn get-backend-version",
    "update:force": "yarn update-artifacts --force && yarn generate-api --force && yarn get-backend-version",
    "update:schema": "yarn update-artifacts:schema && yarn generate-api",
    "generate-api": "tsx openapi/scripts/generate-api-smart.ts",
    "update-artifacts": "tsx scripts/update-artifacts/main.ts",
    "update-artifacts:jar": "tsx scripts/update-artifacts/main.ts --type jar",
    "update-artifacts:schema": "tsx scripts/update-artifacts/main.ts --type schema",
    "get-backend-version": "tsx scripts/get-backend-version.ts",
    "get-api-structure": "tsx scripts/generate-api-structure/main.ts"
  },

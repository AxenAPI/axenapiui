# Включает подробный вывод отладочных сообщений electron-builder
#DEBUG=electron-builder
# Использовать жесткие ссылки для ускорения сборки
USE_HARD_LINKS=false
# Гарантирует, что electron-builder не использует кэшированную конфигурацию
ELECTRON_BUILDER_NO_CACHE=true
# Запрещает скачивание зависимостей из сети.
ELECTRON_BUILDER_OFFLINE=false
